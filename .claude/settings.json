{
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/dev/athena-python/.venv/Scripts/python.exe C:/dev/athena-python/.claude/hooks/guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "C:/dev/athena-python/.venv/Scripts/python.exe C:/dev/athena-python/.claude/hooks/post_compile.py"
          }
        ]
      }
    ]
  }
}
