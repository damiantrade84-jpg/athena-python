# AI review provider routing. Valid values: openai, claude, grok.
AI_REVIEW_PROVIDER=openai
AI_REVIEW_FALLBACK_PROVIDERS=claude,grok

# OpenAI Responses API for global AI review.
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_REVIEW_MODEL=gpt-5.5
OPENAI_REVIEW_REASONING_EFFORT=xhigh
OPENAI_REVIEW_MAX_OUTPUT_TOKENS=12000
OPENAI_REVIEW_TIMEOUT_SECONDS=120
OPENAI_REVIEW_ENABLED=true
